{
  "name": "aazhi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Preflight AI API — Express, PostgreSQL, MongoDB",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "prisma migrate deploy && node --watch src/server.js",
    "dev": "prisma migrate deploy && node src/server.js",
    "postinstall": "prisma generate",
    "dev:watch": "node --watch src/server.js",
    "start:prod": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "docker:db": "docker compose up -d postgres mongo",
    "docker:up": "docker compose up --build",
    "docker:up:detached": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "prisma": "^6.19.3"
  }
}
