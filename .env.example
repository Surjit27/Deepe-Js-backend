NODE_ENV=development
PORT=4000

# Frontend dev (both hostnames)
CORS_ORIGIN=http://home.localhost:5173,http://client.localhost:5173,http://admin.localhost:5173,http://localhost:5173

# PostgreSQL (relational)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=aazhi
POSTGRES_PASSWORD=aazhi
POSTGRES_DB=aazhi
# Required by Prisma. Same database as POSTGRES_* above.
DATABASE_URL=postgresql://aazhi:aazhi@127.0.0.1:5433/aazhi

# MongoDB (document / NoSQL)
MONGODB_URI=mongodb://127.0.0.1:27017/aazhi

# Redis for BullMQ. Start with: docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6379

# Auth (users live in PostgreSQL)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@aazhi.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Platform Admin

# SendGrid (https://app.sendgrid.com/settings/api_keys). Leave blank to paste the key in Admin Settings.
SENDGRID_API_KEY=

# Python AI worker (../Python-backend). Same key as Python INTERNAL_API_KEY.
PYTHON_BACKEND_URL=http://127.0.0.1:4100
INTERNAL_API_KEY=change-me-long-random

# Optional GitHub fallback for private repos (when client has not saved a PAT in the portal).
# Use the Gmail / primary email on the GitHub account plus a PAT or fine-grained token.
GITHUB_ACCOUNT_EMAIL=
GITHUB_TOKEN=
