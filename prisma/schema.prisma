// One shared table per kind of data. A new client does not get its own physical
// tables. Add a model here, give it clientId -> User, then run:
//   npx prisma migrate dev --name add_client_orders

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Portal account. Client-owned models should reference this id.
model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  role           String   @db.VarChar(40)
  accessRoleKey  String   @default("super_admin") @map("access_role_key") @db.VarChar(40)
  tenantOwnerId  String?  @map("tenant_owner_id") @db.Uuid
  displayName    String   @default("") @map("display_name") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role], map: "idx_users_role")
  @@index([tenantOwnerId], map: "idx_users_tenant_owner")
  @@map("users")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(40)
  label     String   @db.VarChar(80)
  portal    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("roles")
}

model EmailSettings {
  id             Boolean  @id @default(true)
  enabled        Boolean  @default(false)
  host           String   @default("") @db.VarChar(255)
  port           Int      @default(587)
  secure         Boolean  @default(false)
  username       String   @default("") @db.VarChar(255)
  passwordCipher String   @default("") @map("password_cipher")
  apiKeyCipher   String   @default("") @map("api_key_cipher")
  fromEmail      String   @default("") @map("from_email") @db.VarChar(255)
  fromName       String   @default("") @map("from_name") @db.VarChar(255)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_settings")
}

model JobTrigger {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(120)
  triggerType String    @map("trigger_type") @db.VarChar(20)
  recurrence  String    @default("daily") @db.VarChar(20)
  startAt     DateTime? @map("start_at") @db.Timestamptz(6)
  eventName   String    @default("") @map("event_name") @db.VarChar(120)
  dependsOn   String?   @map("depends_on") @db.Uuid
  target      String    @db.VarChar(200)
  payload     Json      @default("{}")
  enabled     Boolean   @default(true)
  lastStatus  String    @default("never") @map("last_status") @db.VarChar(20)
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent     JobTrigger?  @relation("JobDependency", fields: [dependsOn], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dependents JobTrigger[] @relation("JobDependency")

  @@map("job_triggers")
}

/// Append-only activity log (PaperTrail-style; see src/audit/).
model AuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain       String   @db.VarChar(20)
  action       String   @db.VarChar(80)
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  subjectId    String?  @map("subject_id") @db.VarChar(120)
  subjectLabel String   @default("") @map("subject_label") @db.VarChar(255)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([domain, createdAt(sort: Desc)], map: "idx_audit_events_domain_created")
  @@index([createdAt(sort: Desc)], map: "idx_audit_events_created")
  @@map("audit_events")
}

model FeatureFlag {
  key            String   @id @db.VarChar(64)
  label          String   @db.VarChar(120)
  description    String   @default("")
  navPath        String   @default("") @map("nav_path") @db.VarChar(120)
  defaultEnabled Boolean  @default(true) @map("default_enabled")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model ClientFeatureFlagOverride {
  clientUserId String   @map("client_user_id") @db.Uuid
  flagKey      String   @map("flag_key") @db.VarChar(64)
  enabled      Boolean
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([clientUserId, flagKey])
  @@map("client_feature_flag_overrides")
}

model ClientSchemaRegistry {
  clientUserId      String   @id @map("client_user_id") @db.Uuid
  schemaName        String   @unique @map("schema_name") @db.VarChar(80)
  migrationVersion  String   @default("0001") @map("migration_version") @db.VarChar(32)
  provisionedAt     DateTime @default(now()) @map("provisioned_at") @db.Timestamptz(6)

  @@map("client_schema_registry")
}
